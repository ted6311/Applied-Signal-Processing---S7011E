clear; clc; 

%% 2.1 Noise cancellation with wiener filters

load("wiener_data.mat") % x[n]

% d[n] = desired signal

% v[n] = colored noise

% x[n]= v[n] {0≤n≤1000}, v[n]+d[n] {1001≤n≤2000}
% which here is: x[n]= v[n] {1≤n≤1001}, v[n]+d[n] {1002≤n≤2001}

v = x(1:10000);
x2 = x(10001:20000);


%% a) 

% Noise = stationary



[acf,lags] = xcorr(v, 'biased');

figure;
plot(lags, acf);
xlabel('Lag k');
ylabel('Autocorrelation r_{v}[k]');
title('ACF of noise v[n]');
grid on;

% we see that it's symmetrical. i.e. r_{v}[k]=r_{v}[-k]


% seperate to 10 segments of 2000 SAMPLES each

acf_total = zeros(1, 2*2000-1);

for k = 1:10
    segment = v((k-1)*1000+1 : k*1000);
    acf_segment = xcorr(segment, 'biased');
    acf_total = acf_total + acf_segment;
end

acf_avg = acf_total / 10;

lags = -999:999;

figure;
plot(lags, acf_avg);
xlabel('Lag k');
ylabel('Autocorrelation r_{v}[k]');
title('Average ACF using 10 segments');
grid on;

%% b) plot xn=dn+vn ACF

[acf2,lags2] = xcorr(x2, 'biased');

figure;
plot(lags2, acf2);
xlabel('Lag k');
ylabel('Autocorrelation r_{x}[k]');
title('ACF of x[n]=v[n]+d[n]');
grid on;


idx = lags2 >= 0;

figure;
plot(lags2(idx), acf2(idx));
xlabel('Lag k');
ylabel('Autocorrelation r_x[k]');
title('Positive lags of ACF of x[n]');
grid on;

test = acf2(idx);


%% c) Wiener filter for suppresing v[n] in x[n]

% The easiest sol might be to estimate the noise so we later can calculate:
% hat{d}=x-hat{v}

% Wiener hopf: Rxx*w=r_{vx} (v is what we search for and x is the input)


M = 20; % Filter order

[acf_v, lags_v] = xcorr(v, M-1, 'biased');
r_vv = acf_v(lags_v >= 0);


[acf_x, lags_x] = xcorr(x2, M-1, 'biased');
r_xx = acf_x(lags_x >= 0);

% Autocorrelation-matrix
R_xx = toeplitz(r_xx);

% correlation between x and v
% Assuming d[n] and v[n] are uncorrelated:
% r_xv[k] = r_vv[k]

r_xv = r_vv(:);


w = R_xx \ r_xv;

% Estimate noise in the entire signal

% test, bara för x[n]=d[n]+v[n] 

A = x(10001:20000);

%v_hat = filter(w, 1, x);
v_hat = filter(w, 1, A);


% d_hat = x - v_hat;
d_hat = A - v_hat

% Plot 

figure;
subplot(2,1,1);
plot(x);
title('Original signal x[n]');
xlabel('n');
ylabel('Amplitude');
grid on;

subplot(2,1,2);
plot(d_hat);
title('Filtered signal d_{hat}[n]');
xlabel('n');
ylabel('Amplitude');
grid on;



% Freq response

figure;
freqz(w, 1, 1024);
title('Frequency response of Wiener filter');


figure;
hold on;
plot(x)
grid on;
title('Complete signal x[n]');